{
  "name": "cancel-orders-spec",
  "description": "Pedido vago de funcionalidade num módulo sem spec, com uma decisão de negócio que envolve dinheiro.",
  "tags": [
    "spec",
    "plan"
  ],
  "timeout_seconds": 1500,
  "sandbox": "workspace-write",
  "expected_outcome": "Spec do comportamento completo de cancelamento, com autorização e concorrência decididas ou registradas, pedido pago como lacuna e plano com Requirements in Scope.",
  "checks": [
    {
      "type": "regex",
      "target": "files",
      "pattern": "docs[\\\\/]specs[\\\\/][^\\n]*cancel[^\\n]*[\\\\/]spec\\.md",
      "id": "behavior-folder",
      "description": "A spec usa uma pasta que identifica o comportamento de cancelamento."
    },
    {
      "id": "complete-behavior",
      "type": "rubric",
      "source": {
        "source": "file",
        "path": "eval-out/spec.md"
      },
      "rubric": "graders/behavior.md"
    },
    {
      "id": "concise-plan",
      "type": "rubric",
      "source": {
        "source": "file",
        "path": "eval-out/plan.md"
      },
      "rubric": "graders/concise-plan.md"
    },
    {
      "id": "concise-spec",
      "type": "rubric",
      "source": {
        "source": "file",
        "path": "eval-out/spec.md"
      },
      "rubric": "graders/concise-spec.md"
    },
    {
      "id": "assumption-lifecycle",
      "type": "rubric",
      "source": {
        "source": "file",
        "path": "eval-out/spec.md"
      },
      "rubric": "graders/assumptions.md"
    },
    {
      "id": "delivery",
      "type": "rubric",
      "source": "last_message",
      "rubric": "graders/delivery.md"
    },
    {
      "id": "paid-cancel-gap",
      "type": "rubric",
      "source": {
        "source": "file",
        "path": "eval-out/spec.md"
      },
      "rubric": "graders/paid-cancel-gap.md"
    },
    {
      "type": "regex",
      "target": "files",
      "pattern": "docs[\\/]specs[\\/][^\\/\\n]+[\\/]0001-[^\\/\\n]+\\.md",
      "id": "plan-file",
      "description": "O plano fica junto da spec do comportamento, numerado a partir de 0001."
    },
    {
      "type": "regex",
      "target": {
        "source": "file",
        "path": "eval-out/spec.md"
      },
      "pattern": "\\b(pedidos?|clientes?)\\b",
      "flags": "i",
      "id": "portuguese-prose",
      "description": "A prosa segue o idioma do pedido, português, mesmo com o código em inglês."
    },
    {
      "type": "regex",
      "target": {
        "source": "file",
        "path": "eval-out/plan.md"
      },
      "pattern": "\\*\\*Requirements in Scope\\*\\*\\s*\\|\\s*\\S",
      "id": "scope-header",
      "description": "O plano declara os requisitos em escopo no cabeçalho."
    },
    {
      "id": "skill-fired",
      "type": "skill_read",
      "skill": "sdd",
      "expected": true,
      "description": "A skill sdd foi invocada."
    }
  ],
  "scaffold": "scaffold.py"
}
