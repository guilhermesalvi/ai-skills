{
  "name": "implement-and-verify",
  "description": "Implementação de um plano existente, com testes a criar, checks a marcar e verificação no fim.",
  "tags": [
    "implement",
    "tests"
  ],
  "expected_outcome": "cancel implementado com os testes nomeados no plano, todos os checks marcados depois de executados, e um relatório de verificação.",
  "sandbox": "workspace-write",
  "timeout_seconds": 2400,
  "checks": [
    {
      "id": "checks-marked",
      "type": "regex",
      "target": {
        "path": "docs/specs/order-lifecycle/0001-customer-cancellation.md"
      },
      "pattern": "- \\[ \\]",
      "match": "not_contains"
    },
    {
      "id": "existing-tests-kept",
      "type": "regex",
      "target": {
        "path": "tests/test_orders.py"
      },
      "pattern": "^(?=[\\s\\S]*def test_pay_charges_total)(?=[\\s\\S]*def test_cannot_ship_unpaid)"
    },
    {
      "id": "named-tests",
      "type": "regex",
      "target": {
        "path": "tests/test_orders.py"
      },
      "pattern": "^(?=[\\s\\S]*def test_customer_cancels_pending_order)(?=[\\s\\S]*def test_other_customer_cannot_cancel)(?=[\\s\\S]*def test_cancel_rejected_outside_pending)(?=[\\s\\S]*def test_cancelled_order_rejects_transitions)(?=[\\s\\S]*def test_cancellation_contract)"
    },
    {
      "id": "report",
      "type": "rubric",
      "source": "last_message",
      "rubric": "graders/report.md"
    },
    {
      "id": "skill-fired",
      "type": "skill_read",
      "skill": "sdd",
      "expected": true,
      "arm": "plugin"
    },
    {
      "id": "tests-passed",
      "type": "rubric",
      "source": "trace",
      "rubric": "graders/tests-passed.md"
    },
    {
      "id": "tests-ran",
      "type": "command",
      "pattern": "unittest",
      "exit_code": 0
    }
  ],
  "scaffold": "scaffold.py"
}
